---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../lib/url';
import { SITE, SOCIAL_LINKS } from '../consts';
import { t } from '../i18n';

const bundlePath = withBase('/pagefind/');

// 联系区社交：过滤出非 RSS 的可展示项
const contactSocials = SOCIAL_LINKS.filter((s) => s.icon !== 'rss');
// 联系邮箱（占位，可替换为真实地址）
const contactEmail = 'mirrorsariah@gmail.com';
---

<BaseLayout title={t('search.title')} description={`Search posts and works — ${SITE.title}.`}>
  <link slot="head" rel="stylesheet" href={`${bundlePath}pagefind-ui.css`} />
  <section class="page-head section pf-fade">
    <p class="eyebrow">{t('search.eyebrow')}</p>
    <h1>
      <span class="pf-reveal"><span style="animation-delay:.1s">Find&nbsp;</span></span>
      <span class="pf-reveal"><span style="animation-delay:.25s">the&nbsp;</span></span>
      <span class="pf-reveal"><span style="animation-delay:.4s; color: var(--color-accent);">Light</span></span><br>
    </h1>
    <p class="mt-6 max-w-md text-[var(--color-muted)] leading-relaxed pf-fade">
      输入关键词，探索镜头里的万千世界。
    </p>
  </section>

  <section class="section search-section pf-fade" aria-label={t('search.sectionLabel')}>
    <div id="search" data-bundle-path={bundlePath}>
      <p class="search-fallback" set:html={t('search.fallback')} />
    </div>
    <script is:inline data-astro-rerun>
      // `data-astro-rerun` re-runs this after each soft navigation, because the
      // swap replaces `#search` with an empty container. `bundlePath` comes from
      // a data attribute — `define:vars` would strip `data-astro-rerun` from the
      // rendered tag. The IIFE keeps re-runs from redeclaring top-level consts;
      // the UI script itself is only loaded once and reused on later visits.
      (() => {
        const container = document.getElementById('search');
        if (!container) return;
        const bundlePath = container.dataset.bundlePath;
        const initSearch = () => {
          container.querySelector('.search-fallback')?.remove();
          new PagefindUI({
            element: '#search',
            bundlePath,
            showImages: false,
            showSubResults: true,
            autofocus: true,
          });
        };
        if (window.PagefindUI) {
          initSearch();
        } else {
          const script = document.createElement('script');
          script.src = `${bundlePath}pagefind-ui.js`;
          script.onload = initSearch;
          document.head.append(script);
        }
      })();
    </script>
  </section>

  {/* ============ Contact（深色反转） ============ */}
  <section id="contact" class="py-24 md:py-32 px-6 md:px-12 relative overflow-hidden" style="background:#1a1612;color:#faf8f5;">
    <div class="pf-contact-bg" style="color:rgba(250,248,245,.03);">PORTFOLIO</div>
    <div class="max-w-[1400px] mx-auto relative z-10">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">
        <div class="lg:col-span-7">
          <div class="text-xs tracking-[.3em] uppercase text-[var(--color-accent)] mb-6">— Let's work together</div>
          <h2 class="pf-serif text-5xl md:text-7xl lg:text-[5.5rem] leading-[.95]">
            Have a story<br>
            <span class="italic text-[var(--color-accent)]">worth telling?</span>
          </h2>
          <a href={`mailto:${contactEmail}`} class="inline-flex items-center gap-4 mt-12 group">
            <span class="w-16 h-16 rounded-full border border-[#faf8f5]/30 flex items-center justify-center group-hover:bg-[var(--color-accent)] group-hover:border-[var(--color-accent)] transition-colors">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
            </span>
            <span class="text-2xl md:text-3xl pf-serif">
              {contactEmail}
            </span>
          </a>
        </div>
        <div class="lg:col-span-4 lg:col-start-9 grid grid-cols-2 gap-8 self-end">
          {
            contactSocials.filter((s) => s.icon !== 'email').map((s) => (
              <div>
                <div class="text-[10px] tracking-[.25em] uppercase text-[#faf8f5]/40 mb-3">{s.label}</div>
                <a href={s.href} class="hover:text-[var(--color-accent)] transition-colors text-sm" target={s.href.startsWith('http') ? '_blank' : undefined} rel={s.href.startsWith('http') ? 'noopener noreferrer' : undefined}>
                  {s.href.replace(/^https?:\/\/[^/]+/, '')}
                </a>
              </div>
            ))
          }
          <div>
            <div class="text-[10px] tracking-[.25em] uppercase text-[#faf8f5]/40 mb-3">Studio</div>
            <p class="text-sm leading-relaxed">China<br>By appointment</p>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

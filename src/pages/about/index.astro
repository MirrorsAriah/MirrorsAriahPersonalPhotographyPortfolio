---
// The prose on this page is placeholder copy — rewrite it as your own. It is
// intentionally *not* in `src/i18n/`: the dictionary holds UI chrome, so a
// translator isn't handed someone else's biography, and you don't have to open
// a dictionary file to edit your own about page.
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE, SOCIAL_LINKS } from '../../consts';
import { t } from '../../i18n';

// 联系区社交：过滤出非 RSS 的可展示项
const contactSocials = SOCIAL_LINKS.filter((s) => s.icon !== 'rss');
// 联系邮箱（占位，可替换为真实地址）
const contactEmail = 'mirrorsariah@gmail.com';
---

<BaseLayout
  title={t('about.title')}
  description={`About the author behind this ${SITE.title} site.`}
>
  <section class="page-head section pf-fade">
    <p class="eyebrow">{t('about.eyebrow')}</p>
    <h1>
      <span class="pf-reveal"><span style="animation-delay:.1s">The&nbsp;</span></span>
      <span class="pf-reveal"><span style="animation-delay:.25s">Eye&nbsp;</span></span>
      <span class="pf-reveal"><span style="animation-delay:.4s">Behind</span></span><br>
      <span class="pf-reveal"><span style="animation-delay:.55s">the&nbsp;</span></span>
      <span class="pf-reveal"><span style="animation-delay:.7s; color: var(--color-accent);">Lens.</span></span>
    </h1>
    <p class="mt-6 max-w-md text-[var(--color-muted)] leading-relaxed pf-fade">
      不止是按下快门，更是发现那些由人类创造<br>但唯独没有人类存在其中的景色。
    </p>
  </section>

  <section class="section prose-grid pf-fade">
    <div>
      <p class="eyebrow">侧像</p>
      <h2>发现那些<br />由人类创造但唯独没有人类存在其中的景观。</h2>
    </div>
    <div class="prose-stack">
      <p>
        <br /><br />I work across product strategy, interface systems, and technical writing. The common thread
        is structure: making complex material easier to scan, trust, and maintain.
      </p>
      <p>
        Astro Keel leaves room for this kind of context without forcing a loud personal brand.
        Replace this placeholder with a specific background, current role, and the constraints that
        shape your work.
      </p>
    </div>
  </section>

  <section class="section pf-fade" aria-label={t('about.ledgerLabel')}>
    <div class="about-ledger">
      <article>
        <span>01</span>
        <h3>Current focus</h3>
        <p>Designing lean content systems, portfolio surfaces, and editorial product pages.</p>
      </article>
      <article>
        <span>02</span>
        <h3>Background</h3>
        <p>
          Experience spanning frontend implementation, design systems, and writing for technical
          audiences.
        </p>
      </article>
      <article>
        <span>03</span>
        <h3>Contact</h3>
        <p>
          Use this section for availability, collaboration preferences, or a direct contact route.
        </p>
      </article>
    </div>
  </section>

  <section class="section prose-grid about-closing pf-fade">
    <div>
      <p class="eyebrow">Method</p>
      <h2>Structure before surface.</h2>
    </div>
    <div class="prose-stack">
      <p>
        The theme treats the page like a working document: hierarchy first, rhythm second, visual
        signature third. Fine rules, generous spacing, and type contrast carry the identity without
        competing with the content.
      </p>
    </div>
  </section>

  {/* ============ Contact（深色反转） ============ */}
  <section id="contact" class="py-24 md:py-32 px-6 md:px-12 relative overflow-hidden" style="background:#1a1612;color:#faf8f5;">
    <div class="pf-contact-bg" style="color:rgba(250,248,245,.03);">PORTFOLIO</div>
    <div class="max-w-[1400px] mx-auto relative z-10">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">
        <div class="lg:col-span-7">
          <div class="text-xs tracking-[.3em] uppercase text-[var(--color-accent)] mb-6">— Let's work together</div>
          <h2 class="pf-serif text-5xl md:text-7xl lg:text-[5.5rem] leading-[.95]">
            Have a story<br>
            <span class="italic text-[var(--color-accent)]">worth telling?</span>
          </h2>
          <a href={`mailto:${contactEmail}`} class="inline-flex items-center gap-4 mt-12 group">
            <span class="w-16 h-16 rounded-full border border-[#faf8f5]/30 flex items-center justify-center group-hover:bg-[var(--color-accent)] group-hover:border-[var(--color-accent)] transition-colors">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
            </span>
            <span class="text-2xl md:text-3xl pf-serif">
              {contactEmail}
            </span>
          </a>
        </div>
        <div class="lg:col-span-4 lg:col-start-9 grid grid-cols-2 gap-8 self-end">
          {
            contactSocials.filter((s) => s.icon !== 'email').map((s) => (
              <div>
                <div class="text-[10px] tracking-[.25em] uppercase text-[#faf8f5]/40 mb-3">{s.label}</div>
                <a href={s.href} class="hover:text-[var(--color-accent)] transition-colors text-sm" target={s.href.startsWith('http') ? '_blank' : undefined} rel={s.href.startsWith('http') ? 'noopener noreferrer' : undefined}>
                  {s.href.replace(/^https?:\/\/[^/]+/, '')}
                </a>
              </div>
            ))
          }
          <div>
            <div class="text-[10px] tracking-[.25em] uppercase text-[#faf8f5]/40 mb-3">Studio</div>
            <p class="text-sm leading-relaxed">China<br>By appointment</p>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

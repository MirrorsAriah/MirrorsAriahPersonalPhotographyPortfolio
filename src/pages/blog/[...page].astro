---
import { getCollection, render } from 'astro:content';
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Pagination from '../../components/Pagination.astro';
import { withBase } from '../../lib/url';
import { SITE, SOCIAL_LINKS } from '../../consts';
import { formatDate, readingTime, t } from '../../i18n';

export const getStaticPaths = (async ({ paginate }) => {
  const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
    (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf(),
  );
  const allTags = [...new Set(posts.flatMap((post) => post.data.tags))].sort((a, b) =>
    a.localeCompare(b),
  );
  return paginate(posts, { pageSize: 10, props: { allTags } });
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { page, allTags } = Astro.props;
const posts = page.data;

const readingTimes = new Map(
  await Promise.all(
    posts.map(async (post) => {
      const { remarkPluginFrontmatter } = await render(post);
      return [post.id, readingTime(remarkPluginFrontmatter.minutesRead)] as const;
    }),
  ),
);

const pageTitle =
  page.currentPage === 1 ? t('blog.title') : t('blog.titlePaged', { page: page.currentPage });

// 联系区社交：过滤出非 RSS 的可展示项
const contactSocials = SOCIAL_LINKS.filter((s) => s.icon !== 'rss');
// 联系邮箱（占位，可替换为真实地址）
const contactEmail = 'mirrorsariah@gmail.com';
---

<BaseLayout
  title={pageTitle}
  description={`Notes and writing — ${SITE.title}, a minimal portfolio and blog theme for Astro.`}
>
  <section class="page-head section pf-fade">
    <p class="eyebrow">{t('blog.eyebrow')}</p>
    <h1>
      <span class="pf-reveal"><span style="animation-delay:.1s">Before&nbsp;</span></span>
      <span class="pf-reveal"><span style="animation-delay:.25s">&</span></span>
      <span class="pf-reveal"><span style="animation-delay:.4s">After</span></span><br>
      <span class="pf-reveal"><span style="animation-delay:.55s">the&nbsp;</span></span>
      <span class="pf-reveal"><span style="animation-delay:.7s; color: var(--color-accent);">Shutter.</span></span>
    </h1>
    <p class="mt-6 max-w-md text-[var(--color-muted)] leading-relaxed pf-fade">
      每张照片背后，都有一段等待被讲述的故事。
    </p>
  </section>

  <section class="section content-index pf-fade" aria-label={t('blog.listLabel')}>
    <div class="index-sidebar">
      <p class="eyebrow">{t('blog.tagsEyebrow')}</p>
      <nav class="tag-cloud" aria-label={t('blog.tagsNavLabel')}>
        {allTags.map((tag) => <a href={withBase(`/blog/tags/${tag}/`)}>{tag}</a>)}
      </nav>
    </div>

    <div>
      <div class="entry-list">
        {
          posts.map((post) => (
            <article class="entry-card">
              <div class="entry-meta">
                <time datetime={post.data.publishDate.toISOString()}>
                  {formatDate(post.data.publishDate, 'short')}
                </time>
                <span>{readingTimes.get(post.id)}</span>
                <span>{post.data.tags.join(' / ')}</span>
              </div>
              <h2>
                <a href={withBase(`/blog/${post.id}/`)}>{post.data.title}</a>
              </h2>
              <p>{post.data.description}</p>
            </article>
          ))
        }
      </div>
      <Pagination page={page} />
    </div>
  </section>

  {/* ============ Contact（深色反转） ============ */}
  <section id="contact" class="py-24 md:py-32 px-6 md:px-12 relative overflow-hidden" style="background:#1a1612;color:#faf8f5;">
    <div class="pf-contact-bg" style="color:rgba(250,248,245,.03);">PORTFOLIO</div>
    <div class="max-w-[1400px] mx-auto relative z-10">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">
        <div class="lg:col-span-7">
          <div class="text-xs tracking-[.3em] uppercase text-[var(--color-accent)] mb-6">— Let's work together</div>
          <h2 class="pf-serif text-5xl md:text-7xl lg:text-[5.5rem] leading-[.95]">
            Have a story<br>
            <span class="italic text-[var(--color-accent)]">worth telling?</span>
          </h2>
          <a href={`mailto:${contactEmail}`} class="inline-flex items-center gap-4 mt-12 group">
            <span class="w-16 h-16 rounded-full border border-[#faf8f5]/30 flex items-center justify-center group-hover:bg-[var(--color-accent)] group-hover:border-[var(--color-accent)] transition-colors">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
            </span>
            <span class="text-2xl md:text-3xl pf-serif">
              {contactEmail}
            </span>
          </a>
        </div>
        <div class="lg:col-span-4 lg:col-start-9 grid grid-cols-2 gap-8 self-end">
          {
            contactSocials.filter((s) => s.icon !== 'email').map((s) => (
              <div>
                <div class="text-[10px] tracking-[.25em] uppercase text-[#faf8f5]/40 mb-3">{s.label}</div>
                <a href={s.href} class="hover:text-[var(--color-accent)] transition-colors text-sm" target={s.href.startsWith('http') ? '_blank' : undefined} rel={s.href.startsWith('http') ? 'noopener noreferrer' : undefined}>
                  {s.href.replace(/^https?:\/\/[^/]+/, '')}
                </a>
              </div>
            ))
          }
          <div>
            <div class="text-[10px] tracking-[.25em] uppercase text-[#faf8f5]/40 mb-3">Studio</div>
            <p class="text-sm leading-relaxed">China<br>By appointment</p>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
